# Kopiraj u .env i po potrebi izmeni: cp .env.example .env
NODE_ENV=development
PORT=3000

# Origin sa kog Vite dev server zove API
CORS_ORIGIN=http://localhost:5173

# Mora da se poklapa sa docker-compose.yml u root-u projekta
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=nextora
DB_PASSWORD=nextora
DB_NAME=nextora

# true ispisuje svaki SQL upit u konzolu
DB_LOGGING=false
